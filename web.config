<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument enabled="true">
            <files>
                <clear />
                <add value="index.html" />
                <add value="index.htm" />
                <add value="default.html" />
            </files>
        </defaultDocument>
        <rewrite>
            <rules>
                <!-- TVS Group Case Insensitive and Alias Rules -->
                <rule name="TVS Group Case Insensitive Aliases" stopProcessing="true">
                    <match url="^(tvsgroup|TVSGroup|tvs-group|TVS-Group)/?$" ignoreCase="true" />
                    <action type="Rewrite" url="tvs-group/index.html" />
                </rule>

                <!-- Core Navigation Section Rewrites -->
                <rule name="About Us Rewrite" stopProcessing="true">
                    <match url="^(about-us|aboutus)/?$" ignoreCase="true" />
                    <action type="Rewrite" url="about-us/index.html" />
                </rule>
                <rule name="Products Rewrite" stopProcessing="true">
                    <match url="^(products|products-solutions)/?$" ignoreCase="true" />
                    <action type="Rewrite" url="products/index.html" />
                </rule>
                <rule name="Automations Rewrite" stopProcessing="true">
                    <match url="^automations/?$" ignoreCase="true" />
                    <action type="Rewrite" url="automations/index.html" />
                </rule>
                <rule name="IIoT Rewrite" stopProcessing="true">
                    <match url="^(iiot|iiot-4-0)/?$" ignoreCase="true" />
                    <action type="Rewrite" url="iiot/index.html" />
                </rule>
                <rule name="Manufacturing Excellence Rewrite" stopProcessing="true">
                    <match url="^manufacturing-excellence/?$" ignoreCase="true" />
                    <action type="Rewrite" url="manufacturing-excellence/index.html" />
                </rule>
                <rule name="Media Rewrite" stopProcessing="true">
                    <match url="^(media|media-tvvs|media-tvs)/?$" ignoreCase="true" />
                    <action type="Rewrite" url="media/index.html" />
                </rule>
                <rule name="Customers Rewrite" stopProcessing="true">
                    <match url="^customers/?$" ignoreCase="true" />
                    <action type="Rewrite" url="customers/index.html" />
                </rule>
                <rule name="Careers Rewrite" stopProcessing="true">
                    <match url="^careers/?$" ignoreCase="true" />
                    <action type="Rewrite" url="careers/index.html" />
                </rule>
                <rule name="Reach Us Rewrite" stopProcessing="true">
                    <match url="^(reach-us|contact|contact-us)/?$" ignoreCase="true" />
                    <action type="Rewrite" url="reach-us/index.html" />
                </rule>

                <!-- General Static Subfolder index.html Fallback -->
                <rule name="Static Subfolder Rewrite" stopProcessing="true">
                    <match url="^([^.]+)$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{DOCUMENT_ROOT}/{R:1}/index.html" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="{R:1}/index.html" />
                </rule>
            </rules>
        </rewrite>
        <staticContent>
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <remove fileExtension=".woff" />
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <remove fileExtension=".svg" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".pdf" />
            <mimeMap fileExtension=".pdf" mimeType="application/pdf" />
        </staticContent>
        <httpErrors errorMode="Custom" existingResponse="Auto">
            <remove statusCode="404" subStatusCode="-1" />
            <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
        </httpErrors>
    </system.webServer>
</configuration>
